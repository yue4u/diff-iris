}
.total-updated .total-packages {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
}
.total-package {
  align-items: baseline;
  background: color-mix(in srgb, var(--paper) 52%, transparent);
  border: 1px solid var(--line);
  border-radius: 8px;
  display: flex;
  flex-wrap: wrap;
