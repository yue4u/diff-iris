}
.total-package span {
  overflow-wrap: anywhere;
}
.range-panel {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 16px;
  margin: 28px 0;
  padding: 20px;
}
.timeline {
  height: 62px;
  position: relative;
  margin: 10px 2px 18px;
}
.timeline-bars {
  align-items: end;
  display: flex;
  gap: 2px;
  height: 58px;
  overflow: hidden;
}
.timeline-bar {
  background: color-mix(in srgb, var(--accent) 42%, transparent);
  flex: 1;
  min-width: 1px;
}
.slider-track {
  --start: 0%;
  --end: 100%;
  background: linear-gradient(
    to right,
    transparent var(--start),
    var(--accent) var(--start),
    var(--accent) var(--end),
    transparent var(--end)
  );
  bottom: -5px;
  height: 4px;
  left: 0;
  position: absolute;
  right: 0;
}
.slider {
  appearance: none;
  background: transparent;
  bottom: -12px;
  height: 20px;
  left: 0;
  margin: 0;
  pointer-events: none;
  position: absolute;
  width: 100%;
}
.slider::-webkit-slider-thumb {
  appearance: none;
  background: var(--panel);
  border: 3px solid var(--accent);
  border-radius: 50%;
  height: 18px;
  pointer-events: auto;
  width: 18px;
}
.slider::-moz-range-thumb {
  background: var(--panel);
  border: 3px solid var(--accent);
  border-radius: 50%;
  height: 13px;
  pointer-events: auto;
  width: 13px;
}
.date-controls {
  align-items: end;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}
.date-controls label {
  color: var(--muted);
  display: grid;
  font-size: 14px;
  font-weight: 700;
  gap: 5px;
  text-transform: uppercase;
}
input[type="date"],
button {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--ink);
  font: inherit;
  padding: 8px 10px;
}
button {
  cursor: pointer;
}
