// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders an offline document and escapes untrusted report data 1`] = `
"<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>fixture dependency history</title>
  <style>:root {
